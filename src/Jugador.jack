/**
 * Clase Jugador
  Encargada de rperesentar la logica de movimiento del jugador y
   dibujar las diferentes formas que puede tomar
 * 
 */

class Jugador {
//ATRIBUTOS
    field int posX, posY;
    field int forma;
    field int tamano;
// CONSTRUCTOR, recibe la posicion del eje y, x, la forma y el tamaño
    constructor Jugador new(int x, int y, int f, int t) {
        let posX = x;
        let posY = y;
        let forma = f;
        let tamano = t;
        return this;
    }
 // metodos get que retornan la posicion del jugador
    method int obtenerPosX() { return posX; }
    method int obtenerPosY() { return posY; }
// metodo que permite que el jugador se mueva, recibe la direccion y una variable tipo mapa
    method void mover(int direccion, Mapa mapa) {
        var int nx, ny;
        let nx = posX;
        let ny = posY;
    // aqui decidimos en que direccion va a dirigirse el player
// si la dir es 1, se mueve hacia arriba
// si la dir es 2, se mueve hacia abajo
// si la dir es 3 se mueve hacia la izq
// si la dir es 4, se mueve a la derecha
        if (direccion = 1) { let ny = posY - 1; }
        if (direccion = 2) { let ny = posY + 1; }
        if (direccion = 3) { let nx = posX - 1; }
        if (direccion = 4) { let nx = posX + 1; }
// verificamos si la posicion a la cual se dirige el player colisiona con una pared
// por eso usamos la var mapa
        if (mapa.esPared(ny, nx) = 0) {
            let posX = nx;
            let posY = ny;
        }
        return;
    }
// metodo que permite dibujar las diferentes formas que puede tener el player
    method void dibujar() {
        var int baseX, baseY;
        let baseX = posX * 32;
        let baseY = posY * 32;

        // Forma 0: Cuadrado con borde blanco (para distinguir del enemigo)
        if (forma = 0) {
            if (tamano = 1) {
                // Cuadrado normal con borde blanco
                do Screen.setColor(true);
                do Screen.drawRectangle(baseX + 4, baseY + 4, baseX + 28, baseY + 28);
                // Borde blanco interior para distinguir
                do Screen.setColor(false);
                do Screen.drawRectangle(baseX + 8, baseY + 8, baseX + 24, baseY + 24);
                do Screen.setColor(true);
                do Screen.drawRectangle(baseX + 12, baseY + 12, baseX + 20, baseY + 20);
            } else {
                // Cuadrado pequeno con borde blanco
                do Screen.setColor(true);
                do Screen.drawRectangle(baseX + 8, baseY + 8, baseX + 24, baseY + 24);
                do Screen.setColor(false);
                do Screen.drawRectangle(baseX + 11, baseY + 11, baseX + 21, baseY + 21);
                do Screen.setColor(true);
                do Screen.drawRectangle(baseX + 14, baseY + 14, baseX + 18, baseY + 18);
            }
        }

        do Screen.setColor(true);

        // Forma 1: Flecha
        if (forma = 1) {
            do Screen.drawLine(baseX + 16, baseY + 4, baseX + 6, baseY + 18);
            do Screen.drawLine(baseX + 16, baseY + 4, baseX + 26, baseY + 18);
            do Screen.drawLine(baseX + 6, baseY + 18, baseX + 26, baseY + 18);
            do Screen.drawRectangle(baseX + 11, baseY + 18, baseX + 21, baseY + 28);
        }

        // Forma 2: Corazon
        if (forma = 2) {
            do Screen.drawCircle(baseX + 11, baseY + 12, 6);
            do Screen.drawCircle(baseX + 21, baseY + 12, 6);
            do Screen.drawLine(baseX + 5, baseY + 14, baseX + 16, baseY + 28);
            do Screen.drawLine(baseX + 27, baseY + 14, baseX + 16, baseY + 28);
            do Screen.drawRectangle(baseX + 10, baseY + 12, baseX + 22, baseY + 20);
        }

        // Forma 3: Muneco de palos
        if (forma = 3) {
            do Screen.drawCircle(baseX + 16, baseY + 8, 5);
            do Screen.drawLine(baseX + 16, baseY + 13, baseX + 16, baseY + 22);
            do Screen.drawLine(baseX + 8, baseY + 16, baseX + 24, baseY + 16);
            do Screen.drawLine(baseX + 16, baseY + 22, baseX + 10, baseY + 29);
            do Screen.drawLine(baseX + 16, baseY + 22, baseX + 22, baseY + 29);
        }

        return;
    }
  // cada vez que se mueve el jugador, debemos borrar la posicion anterior que fue dibujada
    method void borrar() {
        var int baseX, baseY;
        let baseX = posX * 32;
        let baseY = posY * 32;
        do Screen.setColor(false);
        do Screen.drawRectangle(baseX + 2, baseY + 2, baseX + 30, baseY + 30);
        return;
    }    
// metodo que proporciona liberacion de memoria del objeto jugador
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
