/**
 * Clase Juego
 * Encargada de orquestar toda la lógica de las partidas y las pantallas del juego.
 * Actúa como el "Game Manager" (Director de Juego).
 */
class Juego {
    field int partidasJugadas;  // Contador de partidas para forzar limpieza de memoria
    field int modoJuego;        // Almacena el modo seleccionado en el menú (1 a 5)
    field int velocidadEnemigo; // Define qué tan rápido actúa el enemigo en el Game Loop
    field int formaJugador;     // Diseño visual del jugador
    field int formaEnemigo;     // Diseño visual del enemigo
    field int tamano;           // Define el tamaño de los sprites de jugador/enemigo

    /** Constructor de la clase Juego. Inicializa el contador de partidas en 0. */
    constructor Juego new() {
        let partidasJugadas = 0;
        return this;
    }

    /**
     * Método principal que corre toda la lógica del juego.
     * Contiene el bucle principal ("Game Loop") y las llamadas a las distintas interfaces.
     */
    method void ejecutar() {
        var boolean jugarDeNuevo;
        var int semilla;
        var Mapa mapa;
        var Jugador jugador;
        var Enemigo enemigo;
        var boolean juegoTerminado;
        var boolean jugadorGano;
        var char teclaJuego;
        var int direccion;
        var int contadorEnemigo; // Actúa como el timer para la velocidad del enemigo

        let jugarDeNuevo = true;
        
        while (jugarDeNuevo) {
            
            // ========== VERIFICAR LÍMITE DE PARTIDAS ==========
            // Protección contra fragmentación de memoria Heap de la máquina virtual (Max 2 partidas seguidas)
            if (Validador.limitePartidas(partidasJugadas)) {
                do pantallaLimitePartidas();
                return;
            }
            
            // ========== INTERFAZ DE INICIO ==========
            // Muestra el menú interactivo para que el usuario escoja las opciones
            do pantallaInicio();
            
            // Opción 5: Salir del programa por completo
            if (modoJuego = 5) {
                do pantallaDespedida();
                return;
            }
            
            // ========== PANTALLA PRESIONA ENTER ==========
            // Detiene la ejecución esperando un ENTER. El tiempo de demora genera la semilla aleatoria
            let semilla = pantallaPresionaEnter();
            do Random.setSemilla(semilla); // Alimenta al generador matemático de números
            
            // Preparamos la pantalla borrándola
            do Screen.clearScreen();
            
            // Instanciamos el laberinto
            let mapa = Mapa.new();
            
            // Imprimimos la UI estática del tablero
            do Output.moveCursor(0, 0); 
            do Output.printString("INICIO");
            do Output.moveCursor(22, 53); 
            do Output.printString("META");

            // Instanciamos al jugador siempre en la posición inicial (1, 1)
            let jugador = Jugador.new(1, 1, formaJugador, tamano);
            do jugador.dibujar();
            
            // Instanciamos al enemigo (en coordenadas 0,0 por defecto)
            let enemigo = Enemigo.new(0, 0, 1, formaEnemigo, tamano);
            // El enemigo calcula una coordenada aleatoria válida (que no sea pared) para aparecer
            do enemigo.aparecerRandom(mapa);
            do enemigo.dibujar();

            let contadorEnemigo = 0;
            let juegoTerminado = false;
            let jugadorGano = false;

            // ========== GAME LOOP ==========
            // Este es el corazón del juego. Se ejecuta repetidamente hasta que alguien gane o pierda.
            while (~juegoTerminado) {
                
                // 1. Leer el input (dirección) del usuario
                let teclaJuego = Keyboard.keyPressed();
                let direccion = Teclado.leerDireccion(teclaJuego);

                // 2. Mover jugador (Si oprimió una flecha válida)
                if (direccion > 0) {
                    do jugador.borrar(); // Borra el jugador de la posición actual
                    do jugador.mover(direccion, mapa); // Pide cambiar coordenadas si no hay pared
                    do jugador.dibujar(); // Dibuja en la nueva posición
                }

                // 3. Inteligencia del Enemigo
                let contadorEnemigo = contadorEnemigo + 1;
                // El enemigo no se mueve en todos los ticks. Sólo cuando el contador supera su 'velocidad'
                if (contadorEnemigo > velocidadEnemigo) {
                    let contadorEnemigo = 0; // Reiniciar contador
                    do enemigo.borrar();
                    do enemigo.moverHaciaJugador(jugador, mapa); // Llama al algoritmo de persecución (Greedy BFS / IA)
                    do enemigo.dibujar();
                }

                // 4. Lógicas de estado (Reglas de colisión y victoria)
                if (Validador.verificarColision(jugador, enemigo)) {
                    let juegoTerminado = true; // El enemigo te atrapó
                }

                if (Validador.verificarVictoria(jugador)) {
                    let juegoTerminado = true; 
                    let jugadorGano = true; // Llegaste a la meta (15, 7)
                }

                // 5. Tick del reloj (Pausa de 50 milisegundos para no ir exageradamente rápido)
                do Sys.wait(50);
            }

            // ========== PANTALLA DE FIN ==========
            // Se le envía el booleano 'jugadorGano' para saber qué diseño renderizar
            do pantallaFin(jugadorGano);

            // IMPORTANTE: Liberar la memoria RAM asignada a los objetos de esta partida
            // Sin esto, la máquina se quedaría sin memoria Heap inmediatamente
            do jugador.dispose();
            do enemigo.dispose();
            do mapa.dispose();
            
            // Incrementar contador de partidas para eventual limpieza dura
            let partidasJugadas = partidasJugadas + 1;
        }
        return;
    }

    /** Muestra un aviso de límite de memoria y bloquea la ejecución. */
    method void pantallaLimitePartidas() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        
        // Dibujo manual de un recuadro de aviso (Doble borde)
        do Screen.drawRectangle(50, 40, 462, 48);
        do Screen.drawRectangle(50, 200, 462, 208);
        do Screen.drawRectangle(50, 40, 58, 208);
        do Screen.drawRectangle(454, 40, 462, 208);
        
        do Screen.drawRectangle(60, 50, 452, 56);
        do Screen.drawRectangle(60, 190, 452, 196);
        do Screen.drawRectangle(60, 50, 66, 196);
        do Screen.drawRectangle(446, 50, 452, 196);
        
        // Textos del aviso
        do Output.moveCursor(5, 12);
        do Output.printString("================================");
        do Output.moveCursor(6, 12);
        do Output.printString("   RECARGA EL JUEGO PARA");
        do Output.moveCursor(7, 12);
        do Output.printString("   COMENZAR OTRA VEZ");
        do Output.moveCursor(8, 12);
        do Output.printString("================================");
        
        do Output.moveCursor(11, 10);
        do Output.printString("Has jugado varias partidas seguidas.");
        do Output.moveCursor(13, 10);
        do Output.printString("Para limpiar la memoria del sistema,");
        do Output.moveCursor(14, 10);
        do Output.printString("por favor RECARGA el programa.");
        
        do Output.moveCursor(17, 12);
        do Output.printString("Gracias por jugar MAZE RUNNER!");
        do Output.moveCursor(18, 14);
        do Output.printString("Autores: Isa O - Lau C - Juan M");
        
        return;
    }

    /** Menú principal del juego. Lee opciones del usuario y setea las configuraciones base. */
    method void pantallaInicio() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        
        // Bordes de la pantalla de inicio
        do Screen.drawRectangle(50, 25, 462, 30);
        do Screen.drawRectangle(50, 230, 462, 235);
        do Screen.drawRectangle(50, 25, 55, 235);
        do Screen.drawRectangle(457, 25, 462, 235);
        
        do Screen.drawRectangle(60, 35, 452, 40);
        do Screen.drawRectangle(60, 220, 452, 225);
        do Screen.drawRectangle(60, 35, 65, 225);
        do Screen.drawRectangle(447, 35, 452, 225);

        // Títulos principales
        do Output.moveCursor(3, 20);
        do Output.printString("**********************");
        do Output.moveCursor(4, 20);
        do Output.printString("*    MAZE RUNNER     *");
        do Output.moveCursor(5, 20);
        do Output.printString("**********************");

        do Output.moveCursor(7, 22);
        do Output.printString("1. Modo Basico");
        do Output.moveCursor(9, 22);
        do Output.printString("2. Modo Super Rapido");
        do Output.moveCursor(11, 22);
        do Output.printString("3. Cambiar Forma del Jugador");
        do Output.moveCursor(13, 22);
        do Output.printString("4. Cambiar Forma del Enemigo");
        do Output.moveCursor(15, 22);
        do Output.printString("5. Salir del Juego");
        
        do Output.moveCursor(17, 16);
        do Output.printString("Presiona 1, 2, 3, 4 o 5 para elegir");
        do Output.moveCursor(20, 20);
        do Output.printString("Autores: Isa O - Lau C - Juan M");

        // Valores por defecto
        let modoJuego = 0;
        let velocidadEnemigo = 5;
        let formaJugador = 0;
        let formaEnemigo = 0;
        let tamano = 1;

        // Bucle bloqueante esperando que el usuario oprima una de las 5 opciones
        while (modoJuego = 0) {
            let modoJuego = Teclado.leerOpcion(Keyboard.keyPressed());
        }
        do Teclado.esperarTecla();

        // Aplicación de configuraciones según la opción

        // Modo 1: Básico (Enemigo medio rápido)
        if (modoJuego = 1) {
            let formaJugador = 0;
            let formaEnemigo = 0;
            let velocidadEnemigo = 3;
            let tamano = 1;
        }

        // Modo 2: Súper Rápido (Enemigo ataca casi cada 2 ticks, tamaño pequeño para ambos)
        if (modoJuego = 2) {
            let velocidadEnemigo = 2; // Menor número = enemigo se mueve más veces por segundo
            let formaJugador = 0;
            let formaEnemigo = 0;
            let tamano = 2;
        }

        // Modo 3: Sub-menú de forma del jugador
        if (modoJuego = 3) {
            let velocidadEnemigo = 3;
            
            do Screen.clearScreen();
            do Screen.setColor(true);
            do Screen.drawRectangle(100, 50, 412, 55);
            do Screen.drawRectangle(100, 180, 412, 185);
            do Screen.drawRectangle(100, 50, 105, 185);
            do Screen.drawRectangle(407, 50, 412, 185);
            
            do Output.moveCursor(5, 18);
            do Output.printString("ELIGE TU FORMA DE JUGADOR:");
            do Output.moveCursor(9, 24);
            do Output.printString("1. Flecha");
            do Output.moveCursor(11, 24);
            do Output.printString("2. Corazon");
            do Output.moveCursor(13, 24);
            do Output.printString("3. Muneco de Palos");
            
            let formaJugador = 0;
            while (formaJugador = 0) {
                let formaJugador = Teclado.leerOpcionForma(Keyboard.keyPressed());
            }
            do Teclado.esperarTecla();
        }

        // Modo 4: Sub-menú de forma del enemigo
        if (modoJuego = 4) {
            let velocidadEnemigo = 3;
            
            do Screen.clearScreen();
            do Screen.setColor(true);
            do Screen.drawRectangle(100, 50, 412, 55);
            do Screen.drawRectangle(100, 180, 412, 185);
            do Screen.drawRectangle(100, 50, 105, 185);
            do Screen.drawRectangle(407, 50, 412, 185);
            
            do Output.moveCursor(5, 18);
            do Output.printString("ELIGE LA FORMA DEL ENEMIGO:");
            do Output.moveCursor(9, 24);
            do Output.printString("1. Triangulo");
            do Output.moveCursor(11, 24);
            do Output.printString("2. Fuego");
            do Output.moveCursor(13, 24);
            do Output.printString("3. Tridente Maligno");
            
            let formaEnemigo = 0;
            while (formaEnemigo = 0) {
                let formaEnemigo = Teclado.leerOpcionForma(Keyboard.keyPressed());
            }
            do Teclado.esperarTecla();
        }

        return;
    }

    /** Interfaz de despedida al seleccionar salir del juego (Modo 5). */
    method void pantallaDespedida() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do Screen.drawRectangle(100, 80, 412, 85);
        do Screen.drawRectangle(100, 160, 412, 165);
        do Screen.drawRectangle(100, 80, 105, 165);
        do Screen.drawRectangle(407, 80, 412, 165);
        
        do Output.moveCursor(8, 18);
        do Output.printString("Gracias por jugar!");
        do Output.moveCursor(10, 20);
        do Output.printString("MAZE RUNNER");
        do Output.moveCursor(12, 14);
        do Output.printString("Autores: Isa O - Lau C - Juan M");
        return;
    }

    /** 
     * Muestra la pantalla pre-partida.
     * Retorna la entropía (semilla) generada por el tiempo de retraso del usuario al dar enter.
     */
    method int pantallaPresionaEnter() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do Screen.drawRectangle(80, 70, 432, 75);
        do Screen.drawRectangle(80, 170, 432, 175);
        do Screen.drawRectangle(80, 70, 85, 175);
        do Screen.drawRectangle(427, 70, 432, 175);
        
        do Output.moveCursor(6, 23);
        do Output.printString("MAZE RUNNER");
        do Output.moveCursor(10, 13);
        do Output.printString("PRESIONA ENTER PARA EMPEZAR");
        
        // Esta función atrapa la latencia humana para generar aleatoriedad
        return Teclado.obtenerSemillaConEnter();
    }

    /** Interfaz dinámica de conclusión de partida. Recibe booleano de victoria. */
    method void pantallaFin(boolean jugadorGano) {
        do Screen.clearScreen();
        
        if (jugadorGano) {
            // ==== PANTALLA DE VICTORIA ====
            do Screen.setColor(true);
            
            // Dibujar el trofeo/bordes
            do Screen.drawRectangle(40, 20, 472, 28);
            do Screen.drawRectangle(40, 230, 472, 238);
            do Screen.drawRectangle(40, 20, 48, 238);
            do Screen.drawRectangle(464, 20, 472, 238);
            
            // Fuegos artificiales/Estrellas usando primitivas
            do Screen.drawCircle(80, 60, 15);
            do Screen.drawLine(80, 75, 80, 100);
            do Screen.drawCircle(100, 80, 12);
            do Screen.drawLine(100, 92, 100, 115);
            do Screen.drawCircle(65, 90, 10);
            do Screen.drawLine(65, 100, 65, 120);
            
            do Screen.drawCircle(430, 60, 15);
            do Screen.drawLine(430, 75, 430, 100);
            do Screen.drawCircle(410, 80, 12);
            do Screen.drawLine(410, 92, 410, 115);
            do Screen.drawCircle(445, 90, 10);
            do Screen.drawLine(445, 100, 445, 120);
            
            // Trofeo central
            do Screen.drawRectangle(240, 85, 272, 95);
            do Screen.drawRectangle(248, 95, 264, 115);
            do Screen.drawRectangle(235, 115, 277, 125);
            do Screen.drawCircle(256, 75, 12);
            
            do Output.moveCursor(8, 17);
            do Output.printString("*************************");
            do Output.moveCursor(9, 17);
            do Output.printString("*   FELICIDADES!!!      *");
            do Output.moveCursor(10, 17);
            do Output.printString("*   GANASTE EL JUEGO    *");
            do Output.moveCursor(11, 17);
            do Output.printString("*************************");
            
            do Output.moveCursor(14, 20);
            do Output.printString("Eres un verdadero campeon!");
            
        } else {
            // ==== PANTALLA DE DERROTA (GAME OVER) ====
            do Screen.setColor(true);
            
            // Bordes
            do Screen.drawRectangle(50, 30, 462, 38);
            do Screen.drawRectangle(50, 220, 462, 228);
            do Screen.drawRectangle(50, 30, 58, 228);
            do Screen.drawRectangle(454, 30, 462, 228);
            
            // Calavera Gigante (Death Graphic)
            do Screen.drawCircle(256, 100, 40); // Cráneo
            // Ojos en X (muerto)
            do Screen.drawLine(235, 85, 245, 95);
            do Screen.drawLine(245, 85, 235, 95);
            do Screen.drawLine(267, 85, 277, 95);
            do Screen.drawLine(277, 85, 267, 95);
            // Dientes/boca
            do Screen.drawLine(236, 125, 246, 115);
            do Screen.drawLine(246, 115, 266, 115);
            do Screen.drawLine(266, 115, 276, 125);
            do Screen.drawCircle(235, 105, 3);
            do Screen.drawCircle(277, 105, 3);
            
            // Tumbas o cruces a los lados
            do Screen.drawCircle(80, 60, 15);
            do Screen.drawCircle(95, 55, 12);
            do Screen.drawCircle(110, 60, 15);
            do Screen.drawCircle(400, 60, 15);
            do Screen.drawCircle(415, 55, 12);
            do Screen.drawCircle(430, 60, 15);
            
            do Screen.drawLine(75, 80, 75, 95);
            do Screen.drawLine(90, 75, 90, 90);
            do Screen.drawLine(105, 80, 105, 95);
            do Screen.drawLine(395, 80, 395, 95);
            do Screen.drawLine(410, 75, 410, 90);
            do Screen.drawLine(425, 80, 425, 95);
            
            do Output.moveCursor(10, 15);
            do Output.printString("+--------------------------+");
            do Output.moveCursor(11, 15);
            do Output.printString("|   TE ATRAPARON... X_X    |");
            do Output.moveCursor(12, 15);
            do Output.printString("+--------------------------+");
            
            do Output.moveCursor(15, 18);
            do Output.printString("No te rindas, intenta de nuevo!");
        }
        
        do Output.moveCursor(18, 18);
        do Output.printString("Presiona ENTER para Retry");

        // Detener programa hasta que se decida reiniciar
        do Teclado.esperarEnter();
        
        return;
    }

    /** Destructor para liberar de forma forzada esta clase en la memoria Heap */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
