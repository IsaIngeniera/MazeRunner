class Enemigo {
    field int posEnemigoX;
    field int posEnemigoY;
    field int velocidad;
    field int estado;
    field int ejeBloqueado;
    field int direccionEvasion;
    field int sentidoBloqueado;
    field int targetX, targetY;
    field int previaX, previaY;
    field int ultimoX, ultimoY;
    field int forma;
    field int tamano;

    constructor Enemigo new(int posX, int posY, int vel, int f, int t) {
        let posEnemigoX = posX;
        let posEnemigoY = posY;
        let velocidad = vel;
        let estado = 1;
        let ejeBloqueado = 0;
        let direccionEvasion = 0;
        let sentidoBloqueado = 0;
        let previaX = posX;
        let previaY = posY;
        let ultimoX = posX;
        let ultimoY = posY;
        let forma = f;
        let tamano = t;
        return this;
    }

    method int getPosX() { return posEnemigoX; }
    method int getPosY() { return posEnemigoY; }

    method void actualizarTarget(Jugador jugador) {
        var int posX, posY;
        var int dX, dY;
        var int dirX, dirY;
        var int factorPrediccion;
        var int distAEnemigoX, distAEnemigoY, distTotal;
        
        let posX = jugador.obtenerPosX();
        let posY = jugador.obtenerPosY();
        
        // Calcular distancia al jugador
        let distAEnemigoX = posX - posEnemigoX;
        if (distAEnemigoX < 0) { let distAEnemigoX = 0 - distAEnemigoX; }
        let distAEnemigoY = posY - posEnemigoY;
        if (distAEnemigoY < 0) { let distAEnemigoY = 0 - distAEnemigoY; }
        let distTotal = distAEnemigoX + distAEnemigoY;

        // IA AUDAZ: Si el jugador esta lejos, intenta predecir su movimiento e interceptarlo (emboscada).
        // Si esta cerca, lo persigue directamente para asegurar la captura (como Blinky de Pacman).
        if (distTotal > 4) {
            let factorPrediccion = 2; // Predecir 2 casillas adelante
        } else {
            let factorPrediccion = 0; // Ir directo
        }
        
        if ((previaX = 0) & (previaY = 0)) {
            let previaX = posX;
            let previaY = posY; 
        }
        let dX = posX - previaX;
        let dY = posY - previaY; 
        
        if (dX > 0) { let dirX = 1; }
        else { if (dX < 0) { let dirX = -1; } else { let dirX = 0; } }
        let targetX = posX + (dirX * factorPrediccion);

        if (dY > 0) { let dirY = 1; }
        else { if (dY < 0) { let dirY = -1; } else { let dirY = 0; } }
        let targetY = posY + (dirY * factorPrediccion);
        
        if (targetX < 1)  { let targetX = 1; }
        if (targetX > 30) { let targetX = 30; }
        if (targetY < 1)  { let targetY = 1; }
        if (targetY > 14) { let targetY = 14; }

        let previaX = posX;
        let previaY = posY;
        return;
    }

    method int esMovimientoSeguro(int fila, int col, Mapa mapa) {
        if (mapa.esPared(fila, col) = 1) { return 1; }
        if ((col = ultimoX) & (fila = ultimoY)) { return 1; }
        return 0;
    }

    method void darPaso(int nuevoX, int nuevoY) {
        let ultimoX = posEnemigoX;
        let ultimoY = posEnemigoY;
        let posEnemigoX = nuevoX;
        let posEnemigoY = nuevoY;
        return;
    }

    method int calcularDistancia(int x1, int y1, int x2, int y2) {
        var int dx, dy;
        let dx = x1 - x2;
        if (dx < 0) { let dx = 0 - dx; }
        let dy = y1 - y2;
        if (dy < 0) { let dy = 0 - dy; }
        return dx + dy;
    }

    method void moverHaciaJugador(Jugador jugador, Mapa mapa) {
        var int mejorX, mejorY;
        var int minDist;
        var int distActual;
        var boolean movio;
        var int nextX, nextY;
        
        do actualizarTarget(jugador);
        
        let mejorX = posEnemigoX;
        let mejorY = posEnemigoY;
        let minDist = 32000; 
        let movio = false;

        // Intentar Derecha
        let nextX = posEnemigoX + 1;
        let nextY = posEnemigoY;
        if (esMovimientoSeguro(nextY, nextX, mapa) = 0) {
            let distActual = calcularDistancia(nextX, nextY, targetX, targetY);
            if (distActual < minDist) {
                let minDist = distActual;
                let mejorX = nextX;
                let mejorY = nextY;
                let movio = true;
            }
        }
        
        // Intentar Izquierda
        let nextX = posEnemigoX - 1;
        let nextY = posEnemigoY;
        if (esMovimientoSeguro(nextY, nextX, mapa) = 0) {
            let distActual = calcularDistancia(nextX, nextY, targetX, targetY);
            if (distActual < minDist) {
                let minDist = distActual;
                let mejorX = nextX;
                let mejorY = nextY;
                let movio = true;
            }
        }

        // Intentar Abajo
        let nextX = posEnemigoX;
        let nextY = posEnemigoY + 1;
        if (esMovimientoSeguro(nextY, nextX, mapa) = 0) {
            let distActual = calcularDistancia(nextX, nextY, targetX, targetY);
            if (distActual < minDist) {
                let minDist = distActual;
                let mejorX = nextX;
                let mejorY = nextY;
                let movio = true;
            }
        }

        // Intentar Arriba
        let nextX = posEnemigoX;
        let nextY = posEnemigoY - 1;
        if (esMovimientoSeguro(nextY, nextX, mapa) = 0) {
            let distActual = calcularDistancia(nextX, nextY, targetX, targetY);
            if (distActual < minDist) {
                let minDist = distActual;
                let mejorX = nextX;
                let mejorY = nextY;
                let movio = true;
            }
        }

        if (~movio) {
            // Si llega a un callejon sin salida, borramos la memoria del ultimo paso
            // para permitirle dar la vuelta en el proximo turno.
            let ultimoX = 0;
            let ultimoY = 0;
        } else {
            do darPaso(mejorX, mejorY);
        }
        return;
    }

    method void dibujar() {
        var int baseX, baseY;
        let baseX = posEnemigoX * 32;
        let baseY = posEnemigoY * 32;
        
        do Screen.setColor(true);

        // Forma 0: Cuadrado solido (sin borde blanco - diferente al jugador)
        if (forma = 0) {
            if (tamano = 1) {
                // Cuadrado normal completamente negro
                do Screen.drawRectangle(baseX + 4, baseY + 4, baseX + 28, baseY + 28);
            } else {
                // Cuadrado pequeno completamente negro
                do Screen.drawRectangle(baseX + 8, baseY + 8, baseX + 24, baseY + 24);
            }
        }

        // Forma 1: Triangulo (apuntando hacia abajo - amenazante)
        if (forma = 1) {
            do Screen.drawLine(baseX + 16, baseY + 28, baseX + 4, baseY + 6);
            do Screen.drawLine(baseX + 16, baseY + 28, baseX + 28, baseY + 6);
            do Screen.drawLine(baseX + 4, baseY + 6, baseX + 28, baseY + 6);
            // Relleno triangulo
            do Screen.drawLine(baseX + 16, baseY + 26, baseX + 6, baseY + 8);
            do Screen.drawLine(baseX + 16, baseY + 26, baseX + 26, baseY + 8);
            do Screen.drawLine(baseX + 16, baseY + 24, baseX + 8, baseY + 10);
            do Screen.drawLine(baseX + 16, baseY + 24, baseX + 24, baseY + 10);
            do Screen.drawLine(baseX + 16, baseY + 22, baseX + 10, baseY + 12);
            do Screen.drawLine(baseX + 16, baseY + 22, baseX + 22, baseY + 12);
        }

        // Forma 2: Fuego
        if (forma = 2) {
            do Screen.drawCircle(baseX + 16, baseY + 22, 8);
            do Screen.drawLine(baseX + 10, baseY + 16, baseX + 16, baseY + 4);
            do Screen.drawLine(baseX + 22, baseY + 16, baseX + 16, baseY + 4);
            do Screen.drawLine(baseX + 10, baseY + 16, baseX + 22, baseY + 16);
            do Screen.drawLine(baseX + 8, baseY + 20, baseX + 12, baseY + 10);
            do Screen.drawLine(baseX + 24, baseY + 20, baseX + 20, baseY + 10);
        }

        // Forma 3: Tridente Maligno
        if (forma = 3) {
            // Mango central
            do Screen.drawRectangle(baseX + 14, baseY + 14, baseX + 18, baseY + 28);
            // Punta central
            do Screen.drawLine(baseX + 16, baseY + 4, baseX + 12, baseY + 14);
            do Screen.drawLine(baseX + 16, baseY + 4, baseX + 20, baseY + 14);
            // Punta izquierda
            do Screen.drawLine(baseX + 6, baseY + 6, baseX + 8, baseY + 16);
            do Screen.drawLine(baseX + 6, baseY + 6, baseX + 12, baseY + 12);
            do Screen.drawRectangle(baseX + 8, baseY + 14, baseX + 12, baseY + 18);
            // Punta derecha
            do Screen.drawLine(baseX + 26, baseY + 6, baseX + 24, baseY + 16);
            do Screen.drawLine(baseX + 26, baseY + 6, baseX + 20, baseY + 12);
            do Screen.drawRectangle(baseX + 20, baseY + 14, baseX + 24, baseY + 18);
        }

        return;
    }

    method void borrar() {
        var int baseX, baseY;
        let baseX = posEnemigoX * 32;
        let baseY = posEnemigoY * 32;
        do Screen.setColor(false);
        do Screen.drawRectangle(baseX + 2, baseY + 2, baseX + 30, baseY + 30);
        return;
    }

    method void aparecerRandom(Mapa mapa) {
        var int randX, randY;
        var boolean encontrado;
        let encontrado = false;
        while (~encontrado) {
            let randX = Random.randInt(12) + 3;
            let randY = Random.randInt(4) + 3;
            if (mapa.esPared(randY, randX) = 0) {
                let posEnemigoX = randX;
                let posEnemigoY = randY;
                let ultimoX = randX;
                let ultimoY = randY;
                let encontrado = true;
            }
        }
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}