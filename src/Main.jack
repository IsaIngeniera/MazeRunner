/**
 * Clase Main
 * Punto de entrada principal del programa en el entorno Nand2Tetris.
 * Su único objetivo por ahora es instanciar la clase Mapa y mostrarla en pantalla.
 */
class Main {
    function void main() {
        var Mapa mapa;
        var int semilla;

        var Jugador jugador;
        var Enemigo enemigo;
        var boolean juegoTerminado;
        var char teclaJuego;

        let jugarDeNuevo = true;

        while (jugarDeNuevo) {
            // ESTE ES EL MENUU
           // aqui capturamos la semilla para que se genere el enemigo en diferentes lugares cada vez
            do Screen.clearScreen();
            do Output.moveCursor(8, 23);
            do Output.printString("MAZE RUNNER");
            do Output.moveCursor(12, 13);
            do Output.printString("PRESIONA CUALQUIER TECLA PARA EMPEZAR");
            
            let semilla = 0;
            while (Keyboard.keyPressed() = 0) {
                let semilla = semilla + 1;
                if (semilla > 32000) { let semilla = 1; }
            }

            // Esperar a que el jugador suelte la tecla para no arrancar moviéndose solo
            while (~(Keyboard.keyPressed() = 0)) {}

            // Configurar la semilla en la clase Random
            do Random.setSemilla(semilla);
            do Screen.clearScreen();
        }
        // 1. Instanciamos el objeto Mapa
        // Esto ejecuta el constructor, creando la cuadrícula 2D (16x32)
        // y asignando paredes y pasillos.
        let mapa = Mapa.new();

        // 2. Le indicamos al mapa que realice el dibujo en la pantalla
        // Mapeará los 1 y 0 de su matriz a bloques de 16x16.
        do mapa.dibujar();

        // 3. Ciclo infinito
        // Mantiene la ejecución del programa viva para que 
        // podamos visualizar el mapa generado en la pantalla del emulador.
        while (true) {
            // En el futuro, aquí iría la lógica principal del juego (Game Loop),
            // actualizando al jugador y al enemigo.
        }
        do mapa.dispose();
        return;
    }
}